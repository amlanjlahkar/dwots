yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

yabai -m config                                     \
    debug_output                on                  \
    layout                      bsp                 \
    window_shadow               on                  \
    window_placement            first_child         \
    top_padding                 0                   \
    bottom_padding              0                   \
    left_padding                0                   \
    right_padding               0                   \
    window_gap                  0                   \
    auto_balance                on                  \
    mouse_modifier              alt

yabai -m signal --add event=space_created \
    action="~/.config/yabai/scripts/yabai_focus_space \$YABAI_SPACE_ID"

yabai -m rule --add app="^Firefox$" space=^2
yabai -m rule --add app="^WezTerm$" space=^3
yabai -m rule --add app="^Alacritty$" space=^3
yabai -m rule --add app="^Obsidian$" space=4

yabai -m rule --add manage=off sticky=on app="^Music$"
yabai -m rule --add manage=off sticky=on app="^Calculator$"
yabai -m rule --add manage=off app="^LocalSend$"
yabai -m rule --add manage=off app="^Raycast$"
yabai -m rule --add manage=off app="^Transmission$"
yabai -m rule --add manage=off app="^System Settings$"
yabai -m rule --add manage=off app="^Karabiner-Elements$"


