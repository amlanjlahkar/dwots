{
  "title": "Program launcher/switcher",
  "rules": [
    {
      "description": "Launch: Browser",
      "manipulators": [
        {
          "type": "basic",
          "parameters": {
            "basic.simultaneous_threshold_milliseconds": 500
          },
          "from": {
            "simultaneous": [
              {
                "key_code": "p"
              },
              {
                "key_code": "w"
              }
            ],
            "simultaneous_options": {
              "key_down_order": "strict"
            },
            "modifiers": {
              "mandatory": [
                "left_shift",
                "left_control",
                "left_option",
                "left_command"
              ]
            }
          },
          "to": {
            "shell_command": "export MOZ_DISABLE_SAFE_MODE_KEY=1; open /Applications/Firefox.app"
          }
        }
      ]
    },
    {
      "description": "Launch: Terminal",
      "manipulators": [
        {
          "type": "basic",
          "parameters": {
            "basic.simultaneous_threshold_milliseconds": 500
          },
          "from": {
            "simultaneous": [
              {
                "key_code": "p"
              },
              {
                "key_code": "x"
              }
            ],
            "simultaneous_options": {
              "key_down_order": "strict"
            },
            "modifiers": {
              "mandatory": [
                "left_shift",
                "left_control",
                "left_option",
                "left_command"
              ]
            }
          },
          "to": {
            "shell_command": "open /Applications/WezTerm.app"
          }
        }
      ]
    }
  ]
}
