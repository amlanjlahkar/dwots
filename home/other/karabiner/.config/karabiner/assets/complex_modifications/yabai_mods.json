{
  "title": "Yabai Keybinds",
  "rules": [
    {
      "description": "Yabai: Win control mode -> left_option+w",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_ctrl_mode active",
              "type": "variable_unless",
              "value": 1
            }
          ],
          "from": {
            "key_code": "w",
            "modifiers": {
              "mandatory": ["left_option"]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "win_ctrl_mode active",
                "value": 1
              }
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_ctrl_mode active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": {
            "key_code": "w",
            "modifiers": {
              "mandatory": ["left_option"]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "win_ctrl_mode active",
                "value": 0
              }
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_ctrl_mode active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "0" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m space --balance"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_ctrl_mode active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "p" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --toggle split"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_ctrl_mode active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "z" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --toggle zoom-fullscreen"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_ctrl_mode active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "f" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --toggle native-fullscreen"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_ctrl_mode active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "s" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --toggle sticky"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_ctrl_mode active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "spacebar" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --toggle float --grid 4:4:1:1:5:5"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_ctrl_mode active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": {
            "key_code": "j",
            "modifiers": { "mandatory": ["left_shift"] }
          },
          "to": {
            "shell_command": "export PATH='/opt/homebrew/bin:/opt/homebrew/sbin:$PATH'; /bin/sh -c ~/.config/yabai/scripts/yabai_swap_win"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_ctrl_mode active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": {
            "key_code": "k",
            "modifiers": { "mandatory": ["left_shift"] }
          },
          "to": {
            "shell_command": "export PATH='/opt/homebrew/bin:/opt/homebrew/sbin:$PATH'; /bin/sh -c ~/.config/yabai/scripts/yabai_swap_win_anti"
          }
        }
      ]
    },
    {
      "description": "Yabai: Win resize mode -> left_option+r",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_resize_mode active",
              "type": "variable_unless",
              "value": 1
            }
          ],
          "from": {
            "key_code": "r",
            "modifiers": {
              "mandatory": ["left_option"]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "win_resize_mode active",
                "value": 1
              }
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_resize_mode active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": {
            "key_code": "r",
            "modifiers": {
              "mandatory": ["left_option"]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "win_resize_mode active",
                "value": 0
              }
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_resize_mode active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "h" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --resize right:-20:0"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_resize_mode active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "j" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --resize right:0:20"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_resize_mode active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "k" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --resize right:0:-20"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "win_resize_mode active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "l" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --resize right:20:0"
          }
        }
      ]
    },
    {
      "description": "Yabai: Basic keybinds",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "j",
            "modifiers": { "mandatory": ["left_option"] }
          },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --focus next || /opt/homebrew/bin/yabai -m window --focus first"
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "k",
            "modifiers": { "mandatory": ["left_option"] }
          },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --focus prev || /opt/homebrew/bin/yabai -m window --focus last"
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "open_bracket",
            "modifiers": { "mandatory": ["left_option"] }
          },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m space --focus prev || /opt/homebrew/bin/yabai -m space --focus last"
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "close_bracket",
            "modifiers": { "mandatory": ["left_option"] }
          },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m space --focus next || /opt/homebrew/bin/yabai -m space --focus first"
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "tab",
            "modifiers": { "mandatory": ["left_option"] }
          },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m space --focus recent"
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "8",
            "modifiers": { "mandatory": ["left_option"] }
          },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m space --focus 1"
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "9",
            "modifiers": { "mandatory": ["left_option"] }
          },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m space --focus 2"
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "0",
            "modifiers": { "mandatory": ["left_option"] }
          },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m space --focus 3"
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "hyphen",
            "modifiers": { "mandatory": ["left_option"] }
          },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m space --focus 4"
          }
        },
        {
          "type": "basic",
          "from": {
            "key_code": "equal_sign",
            "modifiers": { "mandatory": ["left_option"] }
          },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m space --focus 5"
          }
        },
        {
          "type": "basic",
          "from": { "key_code": "escape" },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 200
          },
          "to": {
            "set_variable": {
              "name": "yabai_win_mover active",
              "value": 1
            }
          },
          "to_if_alone": {
            "key_code": "escape"
          },
          "to_after_key_up": {
            "set_variable": {
              "name": "yabai_win_mover active",
              "value": 0
            }
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "yabai_win_mover active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "8" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --space 1; /opt/homebrew/bin/yabai -m space --focus 1"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "yabai_win_mover active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "9" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --space 2; /opt/homebrew/bin/yabai -m space --focus 2"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "yabai_win_mover active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "0" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --space 3; /opt/homebrew/bin/yabai -m space --focus 3"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "yabai_win_mover active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "hyphen" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --space 4; /opt/homebrew/bin/yabai -m space --focus 4"
          }
        },
        {
          "type": "basic",
          "conditions": [
            {
              "name": "yabai_win_mover active",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": { "key_code": "equal_sign" },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --space 5; /opt/homebrew/bin/yabai -m space --focus 5"
          }
        }
      ]
    }
  ]
}
