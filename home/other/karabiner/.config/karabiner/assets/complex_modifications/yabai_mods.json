        },
        {
          "type": "basic",
          "from": {
            "key_code": "close_bracket",
            "modifiers": {
              "mandatory": [
                "left_shift",
                "left_control",
                "left_option",
                "left_command"
              ]
            }
          },
          "to": {
            "shell_command": "/opt/homebrew/bin/yabai -m window --space next; /opt/homebrew/bin/yabai -m space --focus next"
          }
        }
      ]
    }
  ]
}
