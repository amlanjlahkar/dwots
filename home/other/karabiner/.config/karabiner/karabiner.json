{
    "global": { "check_for_updates_on_startup": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Yabai: Win resize mode -> Hyper+R",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "name": "win_resize_mode active",
                                        "type": "variable_unless",
                                        "value": 1
                                    }
                                ],
                                "from": {
                                    "key_code": "r",
                                    "modifiers": { "mandatory": ["left_shift", "left_control", "left_option", "left_command"] }
                                },
                                "to": [
                                    {
                                        "set_variable": {
                                            "name": "win_resize_mode active",
                                            "value": 1
                                        }
                                    },
                                    {
                                        "set_notification_message": {
                                            "id": "yabai.win_resize_mode",
                                            "text": "Yabai: Window resize mode active(Hyper+R)"
                                        }
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "name": "win_resize_mode active",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": {
                                    "key_code": "r",
                                    "modifiers": { "mandatory": ["left_shift", "left_control", "left_option", "left_command"] }
                                },
                                "to": [
                                    {
                                        "set_variable": {
                                            "name": "win_resize_mode active",
                                            "value": 0
                                        }
                                    },
                                    {
                                        "set_notification_message": {
                                            "id": "yabai.win_resize_mode",
                                            "text": ""
                                        }
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "name": "win_resize_mode active",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": { "key_code": "h" },
                                "to": { "shell_command": "/opt/homebrew/bin/yabai -m window --resize right:-20:0" },
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "name": "win_resize_mode active",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": { "key_code": "j" },
                                "to": { "shell_command": "/opt/homebrew/bin/yabai -m window --resize right:0:20" },
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "name": "win_resize_mode active",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": { "key_code": "k" },
                                "to": { "shell_command": "/opt/homebrew/bin/yabai -m window --resize right:0:-20" },
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "name": "win_resize_mode active",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": { "key_code": "l" },
                                "to": { "shell_command": "/opt/homebrew/bin/yabai -m window --resize right:20:0" },
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "name": "win_resize_mode active",
                                        "type": "variable_if",
                                        "value": 1
                                    }
                                ],
                                "from": { "key_code": "equal_sign" },
                                "to": { "shell_command": "/opt/homebrew/bin/yabai -m space --equalize" },
                                "type": "basic"
                            }
                        ]
                    },
