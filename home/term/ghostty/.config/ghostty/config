auto-update = off

command = "/opt/homebrew/bin/bash -l -c tmux_bind_fzf"
theme = /Users/amlan/.config/ghostty/themes/boo

mouse-hide-while-typing = true
shell-integration-features = true
quit-after-last-window-closed = true
macos-auto-secure-input = true

title = " "
window-save-state = never
window-colorspace = display-p3
# window-decoration = false
window-padding-x = 15
window-padding-y = 15

background-opacity = 1
background-blur = false

font-family = "Source Code Pro"
font-size = 16
# custom-shader = ~/.local/opt/crt-shader-with-chromatic-aberration-glow-scanlines-dot-matrix/crt-shader-with-chromatic-aberration-glow-scanlines-dot-matrix.glsl

keybind = cmd+d=ignore
keybind = ctrl+tab=ignore
keybind = cmd+c=ignore
keybind = cmd+v=ignore
keybind = cmd+p=paste_from_clipboard
keybind = cmd+y=copy_to_clipboard
keybind = global:cmd+semicolon=toggle_quick_terminal

# vim: ft=conf
