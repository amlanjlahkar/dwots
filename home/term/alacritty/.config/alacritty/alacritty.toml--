[general]
import = [
    "~/.config/alacritty/colors/boo_lora.toml"
]

[terminal.shell]
program = "/opt/homebrew/bin/bash"
args = ["--login", "-c", "tmux_bind_fzf"]

[window]
decorations = "buttonless"
dynamic_padding = true
opacity = 0.90
blur = false

[window.padding]
x = 10
y = 10

[cursor]
blink_interval = 800
style = { blinking = "Off", shape = "Block" }
vi_mode_style = "Block"

[mouse]
hide_when_typing = true

[scrolling]
history = 30000

[font]
size = 16
builtin_box_drawing = true
offset = { x = 0, y = 0 }
glyph_offset = { x = 0, y = 0 }

[font.normal]
family = "Source Code Pro"
style = "Regular"

[font.italic]
family = "Source Code Pro"
style = "Italic"

[font.bold]
family = "Source Code Pro"
style = "SemiBold"

[font.bold_italic]
family = "Source Code Pro"
style = "Regular"

[hints]
alphabet = "jfkdls;ahgurieowpq"

[[hints.enabled]]
action = "Copy"
post_processing = true
regex = "(ipfs:|ipns:|magnet:|mailto:|gemini:|gopher:|https:|http:|news:|file:|git:|ssh:|ftp:)[^\u0000-\u001F\u007F-<>\"\\s{-}\\^⟨⟩`]+"

[hints.enabled.binding]
key = "U"
mods = "Control|Shift"

[hints.enabled.mouse]
enabled = true
mods = "None"

[[keyboard.bindings]]
action = "ToggleFullscreen"
key = "F"
mods = "Shift|Super"
