#!/usr/bin/env bash

# Interactive creation of tmux sessions
# dependencies: fzf

declare -A sessions=()
for name in $(tmux ls -F "#{session_name}"); do
    sessions["$name"]="$name"
done

pick() { command fzf --padding 2% --layout='reverse-list' --prompt="$1"; }

csession() {
  read -r -p 'Session Name(default is id): ' session_name
  if [ -n "$session_name" ]; then
    [[ -v sessions["$session_name"] ]] && tmux attach -t "$session_name" || tmux new -s "$session_name"
  else
    tmux new
  fi
}

main() {
    [ -z "$(pgrep tmux)" ] && csession && exit

    chosen="$(printf '%s\n%s\n%s' "Attach" "Pick" "Create" | pick "Choose: ")"

    [ -z "$chosen" ] && exit

    case "$chosen" in
        'Attach')
            tmux attach
            ;;
        'Pick')
            if [[ "${#sessions[@]}" -eq 1 ]]; then
                tmux attach -t "${sessions[$name]}"
                exit
            else
                session_name="$(printf '%s\n' "${sessions[@]}" | pick 'Choose session: ')"
                [ -z "$session_name" ] && exit

                if [[ -v sessions["$session_name"] ]]; then
                    tmux attach -t "$session_name"
                else
                    # should_create="$(printf '%s\n%s' 'Yes' 'No' | pick "Session doesn't exist. Create it? ")"
                    # [[ -z $should_create || $should_create = 'No' || $should_create != 'Yes' ]] && exit
                    # tmux new -s "$session_name"
                    exit
                fi
            fi
            ;;
        'Create')
            csession
            ;;
        *)
            ;;
    esac
}

main
